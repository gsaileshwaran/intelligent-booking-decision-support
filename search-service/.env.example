# PVK Cinemas — Search Service Environment Configuration
# Copy to .env and configure before running

# ============================================================
# DATABASE (read-only access for indexing pipeline only)
# The search service NEVER writes to operational tables.
# ============================================================
SEARCH_DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/pvk_cinemas_db

# ============================================================
# EMBEDDING MODEL
# Model must be downloadable by sentence-transformers
# ============================================================
SEARCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# HYBRID RANKING WEIGHTS (must sum to 1.0)
# ============================================================
SEARCH_LEXICAL_WEIGHT=0.4
SEARCH_SEMANTIC_WEIGHT=0.6

# ============================================================
# SERVICE BINDING
# Bind to 127.0.0.1 in production (internal only)
# ============================================================
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=8001

# ============================================================
# PIPELINE
# ============================================================
SEARCH_PIPELINE_VERSION=v4.0
SEARCH_INDEX_ON_STARTUP=true
