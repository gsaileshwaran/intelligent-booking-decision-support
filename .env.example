# ==============================================================================
# PVK CINEMAS — PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure environment variables accordingly.
# Safe default development values are provided below for local evaluation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pvk_cinemas_db
DB_USER=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE (Java 21 + Spring Boot 3.3.4)
# ------------------------------------------------------------------------------
PORT=8080
JWT_SECRET=your-256-bit-secret-key-change-this-for-production-use-only-2026!
SEARCH_SERVICE_URL=http://127.0.0.1:8001
SEARCH_FALLBACK_ENABLED=true

# ------------------------------------------------------------------------------
# 3. SEARCH SERVICE (Python 3.13 + FastAPI + PyTorch / SentenceTransformers)
# ------------------------------------------------------------------------------
SEARCH_DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/pvk_cinemas_db
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=8001
SEARCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEARCH_LEXICAL_WEIGHT=0.4
SEARCH_SEMANTIC_WEIGHT=0.6
SEARCH_PIPELINE_VERSION=v4.0
SEARCH_INDEX_ON_STARTUP=true

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT (React 19 + Vite)
# ------------------------------------------------------------------------------
VITE_PORT=3000
