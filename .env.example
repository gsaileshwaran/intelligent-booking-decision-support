# ===================================================================
# AI Decision Engine for Intelligent Booking - Environment Configuration
# ===================================================================

# Application Mode
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=intelligent_booking_db
DB_USER=booking_user
DB_PASSWORD=booking_secure_password_123

# Spring Boot Backend API Configuration
BACKEND_PORT=8080
BACKEND_BASE_URL=http://localhost:8080
JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_security_compliance
JWT_EXPIRATION_MS=86400000

# React Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
PORT=3000

# Future AI Decision Service Configuration (Deferred / Boundary Only)
AI_SERVICE_ENABLED=false
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000
